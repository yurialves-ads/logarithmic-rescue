{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Qualidade de código */
    "strict": true,
    "forceConsistentCasingInFileNames": true,

    /* Ajustes úteis */
    "skipLibCheck": true,
    "allowJs": true,

    /* Opcional (controle fino) */
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}